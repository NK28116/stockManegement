{{- /*
  Bitwarden から .env を生成する chezmoi テンプレート (手順: Docs/SECRETS_BITWARDEN.md)

  使い方:  make env
  (中身は `chezmoi execute-template < .env.chezmoi.tmpl > .env`)

  このファイル自体には秘密情報を書かない。秘密の値と環境ごとの識別子
  (パスワードのハッシュ、署名鍵、DB パスワード、バケット名など) は
  Bitwarden の項目「stockManagement」のカスタムフィールドに置き、
  フィールド名をそのまま環境変数名として書き出す。
  項目名は環境変数 STOCK_BW_ITEM で変えられる (項目 ID も指定可)。
*/ -}}
{{- $item := env "STOCK_BW_ITEM" | default "stockManagement" -}}
# このファイルは chezmoi が Bitwarden から生成しました。直接編集せず `make env` で作り直してください。
# リポジトリにはコミットしないこと (.gitignore 済み)。

# --- 実行環境・アプリの設定 (秘密ではない既定値) ---
APP_ENV=local
DB_TYPE=sqlite
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_PUBLIC_PATH_PREFIXES=/auth/login,/auth/logout,/api/auth/status,/health,/static
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_PROXY_COUNT=0
MATPLOTLIB_FONT_STRICT=false

# --- Bitwarden 項目「{{ $item }}」のカスタムフィールド ---
# 上の既定値と同じ名前のフィールドがあれば、後に書かれたこちらが優先される。
{{ range $name, $field := bitwardenFields "item" $item -}}
{{- /* 値が空のフィールドやリンク型のフィールドは、bw の出力に value キー自体が無いことがある */ -}}
{{-   $value := toString (default "" (index $field "value")) -}}
{{-   if not (regexMatch "^[A-Z][A-Z0-9_]*$" $name) }}
# スキップ: フィールド名「{{ $name }}」は環境変数名として使えない (英大文字・数字・_ のみ)
{{-   else if eq (toString (index $field "type")) "3" }}
# スキップ: フィールド「{{ $name }}」はリンク型 (ユーザー名・パスワード欄への参照) のため値を持たない
{{-   else if or (contains "'" $value) (contains "\n" $value) }}
{{ $name }}={{ $value | quote }}
{{-   else }}
{{ $name }}={{ $value | squote }}
{{-   end }}
{{- end }}
