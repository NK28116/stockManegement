# ============================================================
# 環境変数テンプレート（OSS利用者向け）
# 実運用時はこのファイルを .env にコピーし、各値を実値で埋めること。
# .env はリポジトリにコミットしないこと（.gitignore 済み）。
# ============================================================

# --- DB ---
# sqlite を指定すると python/db/ 下の SQLite を使う (開発向け)
# 未設定または postgresql の場合は python/config.py の PostgreSQL 設定を使う
DB_TYPE=sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/stock_db

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/key.json

# --- Slack 通知 ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_WEBHOOK=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX

# --- IAM / Workload Identity Federation (scripts/setup_iam.sh, setup_wif.sh) ---
PROJECT_ID=your-gcp-project-id
BUCKET_NAME=your-gcs-bucket-name
SERVICE_ACCOUNT_NAME=stock-web-ui-sa
CRON_SA_NAME=stock-cron-sa
GITHUB_REPO=your-github-owner/your-repo-name

# --- MCP サーバー ---
# HTTP トランスポートで公開する場合のみ必要。
# Authorization: Bearer <MCP_API_KEY> で検証される。
# 未設定で HTTP 起動すると 無認証 (警告ログ) になるため、
# モバイル / リモート公開時は必ず設定すること。
MCP_API_KEY=replace-with-a-long-random-string

# --- チャートの日本語フォント (PRIDEV-482 / 詳細は Docs/CHART_FONT_SETUP.md) ---
# 使用フォントを明示指定する場合のみ設定する (未設定なら IPAexGothic → OS 標準の順で解決)
MATPLOTLIB_FONT_FAMILY=
# true にすると日本語フォントが無い環境で例外を送出する (文字化け画像の配信防止)
MATPLOTLIB_FONT_STRICT=false

# --- 実行環境 ---
# local / development / dev / test / ci のいずれかを指定した場合のみ「開発環境」とみなす。
# 未設定・その他の値はすべて本番環境として扱われ、認証設定が不足していると起動に失敗する。
APP_ENV=local

# --- 管理画面パスワード認証 (PRIDEV-481 / 設定手順は Docs/AUTH_SETUP.md) ---
# ハッシュ生成: python scripts/hash_password.py
# 平文パスワードは KeePassXC でのみ管理し、ここへは書かないこと。
# 平文の APP_PASSWORD は実装が参照しない (PRIDEV-523)。
# 開発環境で未設定にすると認証は無効。本番では必須 (未設定なら起動しない)。
APP_PASSWORD_HASH=
# セッション Cookie の署名鍵 (本番必須 / 32 文字以上):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
# 認証不要とするパスの前方一致リスト (カンマ区切り)。これ以外はすべて保護対象。
AUTH_PUBLIC_PATH_PREFIXES=/auth/login,/auth/logout,/api/auth/status,/health,/static
# Cookie の Secure 属性。本番では常に true (この値は無視される)。
AUTH_COOKIE_SECURE=false
# 信頼するリバースプロキシの段数。0 なら X-Forwarded-For を一切信用しない。
# Render / Cloud Run など 1 段のプロキシ配下では 1 を指定する。
AUTH_TRUSTED_PROXY_COUNT=0

# --- Cloud Logging / Monitoring 読み取り (PRIDEV-490 / 詳細は Docs/OBSERVABILITY.md) ---
# 以下 4 つはユーザー確認済みの確定値
OBSERVABILITY_LOG_DEFAULT_LOOKBACK_HOURS=24
OBSERVABILITY_LOG_MAX_LOOKBACK_DAYS=7
OBSERVABILITY_LOG_DEFAULT_LIMIT=100
OBSERVABILITY_LOG_MAX_LIMIT=500
# 監視指標 (カンマ区切り、ユーザー確認済みの 6 種)。一覧の範囲外の指定は無視される
OBSERVABILITY_MONITORED_METRICS=service_up,cpu_utilization,memory_utilization,error_count,response_latency,last_success_at

# --- System Monitor 画面の表示件数 (PRIDEV-493) ---
# 以下 4 つはユーザー確認済みの確定値
SYSTEM_MONITOR_INITIAL_ERROR_COUNT=20
SYSTEM_MONITOR_ENABLE_LOAD_MORE=true
SYSTEM_MONITOR_LOAD_MORE_COUNT=20
SYSTEM_MONITOR_MAX_ERROR_COUNT=100

# --- 初回起動待ちの UX (PRIDEV-485 / 実装は python/web/startup.py) ---
# 以下 3 つはユーザー確認済みの確定値
STARTUP_TARGET_SECONDS=10      # 起動完了の目標時間
STARTUP_LOADING_DELAY_SECONDS=1  # loading 表示を開始するまでの遅延
STARTUP_TIMEOUT_SECONDS=30     # timeout とみなす時間 (超過で再試行導線を表示)
