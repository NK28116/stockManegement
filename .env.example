# ===================================================================
# 環境変数テンプレート（OSS利用者向け）
# 実運用時はこのファイルを .env にコピーし、各値を実値で埋めること。
# .env はリポジトリにコミットしないこと（.gitignore 済み）。
# ===================================================================

# --- DB ---
# sqlite を指定すると python/db/ 下の SQLite を使う (開発向け)
# 未設定または postgresql の場合は python/config.py の PostgreSQL 設定を使う
DB_TYPE=sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/stock_db

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/key.json

# --- Slack 通知 ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_WEBHOOK=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX

# --- IAM / Workload Identity Federation (scripts/setup_iam.sh, setup_wif.sh) ---
PROJECT_ID=your-gcp-project-id
BUCKET_NAME=your-gcs-bucket-name
SERVICE_ACCOUNT_NAME=stock-web-ui-sa
CRON_SA_NAME=stock-cron-sa
GITHUB_REPO=your-github-owner/your-repo-name

# --- MCP サーバー ---
# HTTP トランスポートで公開する場合のみ必要。
# Authorization: Bearer <MCP_API_KEY> で検証される。
# 未設定で HTTP 起動すると 無認証 (警告ログ) になるため、
# モバイル / リモート公開時は必ず設定すること。
MCP_API_KEY=replace-with-a-long-random-string

# --- Cloud Logging / Monitoring 読み取り (PRIDEV-490 / 詳細は Docs/OBSERVABILITY.md) ---
# 以下 4 つはユーザー確認済みの確定値
OBSERVABILITY_LOG_DEFAULT_LOOKBACK_HOURS=24
OBSERVABILITY_LOG_MAX_LOOKBACK_DAYS=7
OBSERVABILITY_LOG_DEFAULT_LIMIT=100
OBSERVABILITY_LOG_MAX_LIMIT=500
# 監視指標 (カンマ区切り、ユーザー確認済みの 6 種)。一覧の範囲外の指定は無視される
OBSERVABILITY_MONITORED_METRICS=service_up,cpu_utilization,memory_utilization,error_count,response_latency,last_success_at
